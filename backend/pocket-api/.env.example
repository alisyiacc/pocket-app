APP_NAME=Pocket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1/pocket-api/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database MySQL Laragon (user root, tanpa password) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pocket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Email "lupa kata sandi" ditulis ke storage/logs/laravel.log (cukup untuk demo/UTS).
# Mau kirim email sungguhan? Ganti ke smtp dan isi kredensial SMTP.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pocket.app"
MAIL_FROM_NAME="${APP_NAME}"
