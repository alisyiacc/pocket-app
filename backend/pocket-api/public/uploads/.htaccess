# Folder foto upload Pocket
Options -Indexes

# Izinkan Flutter Web (Chrome) memuat gambar lintas-origin
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# Keamanan: file upload tidak boleh dieksekusi sebagai PHP
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
    Require all denied
</FilesMatch>
